# --- LLM generation via OpenRouter (free tier) ---
# Sign up at https://openrouter.ai — no card needed for free models.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Check https://openrouter.ai/models (filter: Price = Free) before each run —
# the free lineup rotates. These are reasonable picks as of writing.
CHAT_MODEL_FAST=openai/gpt-oss-20b:free
CHAT_MODEL_SMART=openai/gpt-oss-120b:free
CHAT_MODEL_FALLBACK=openrouter/free

# --- Embeddings: local model, no key required ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# --- Web search tool (Tavily via MCP) ---
TAVILY_API_KEY=tvly-your-key-here

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docintel
POSTGRES_USER=docintel
POSTGRES_PASSWORD=changeme

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Langfuse (optional, sign up at cloud.langfuse.com) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Misc ---
BACKEND_PORT=8010
ENRICH_MIN_CHUNK_CHARS=0
